# =====================================================================
# CYLINDRICAL RICHTMYER-MESHKOV INSTABILITY, THREE MATERIALS
# A cylindrical Mach 2 shock in air (material 1) converges on a perturbed
# shell of a heavy gas (material 2, SF6-like) around a light core
# (material 3, helium-like). The shock crosses both interfaces, focuses
# on the axis, reflects and re-shocks them from the inside, so both are
# Richtmyer-Meshkov unstable. The interfaces carry different even modes,
# r = R_12 + a_12 cos(mode_12 theta) and r = R_23 + a_23 cos(mode_23 theta).
# One quarter of the plane is simulated, with symmetry on the x and y
# axes. The case exercises the N-material five-equation model
# (NPHASE = 3) with THINC interface reconstruction and AMR on both
# interfaces and the shocks. CylindricalRM-5Eq in the tutorial is the
# two-material version. Nondimensional units.
# =====================================================================

# =====================================================================
# SIMULATION CONTROL
# =====================================================================
max_step  = 10000000        # Maximum number of time steps to advance
stop_time = 1.0             # Maximum physical time to integrate to


# =====================================================================
# DOMAIN GEOMETRY
# Quarter plane; the implosion center is the origin
# =====================================================================
geometry.prob_lo     =  0.0  0.0  0.0   # Lower bounds (x,y,z)
geometry.prob_hi     =  1.0  1.0  1.0   # Upper bounds (x,y,z)
geometry.is_periodic =  0    0    0


# =====================================================================
# BOUNDARY CONDITIONS
#   0 = Interior    | 1 = Inflow      | 2 = Outflow
#   3 = Symmetry    | 4 = SlipWall    | 5 = NoSlipWall
# =====================================================================
run.lo_bc = 3 3 4            # Symmetry on the x and y axes
run.hi_bc = 2 2 4            # Outflow on the outer edges


# =====================================================================
# VERBOSITY
# =====================================================================
amr.v       = 1
run.sum_var = 0


# =====================================================================
# GRID AND REFINEMENT
# 64 x 64 base cells and three levels, 512 x 512 at the finest level
# (amr.max_level = 4 gives 1024 x 1024)
# =====================================================================
amr.n_cell      = 64 64 8    # Base grid resolution (coarsest level)
amr.max_level   = 3          # Number of refinement levels above the base grid
amr.ref_ratio   = 2 2 2 2 2 2
amr.n_error_buf = 2          # Buffer around tagged cells for refinement

amr.blocking_factor_x = 8
amr.blocking_factor_y = 8
amr.blocking_factor_z = 8
amr.max_grid_size     = 32
amr.regrid_int        = 2
amr.Interpolater      = "lincc_interp"


# =====================================================================
# TIME STEPPING
# =====================================================================
run.cfl                     = 0.3
run.do_subcycle             = 1
run.check_cfl               = 0
run.timestep_change_limiter = 0
run.TimeIntegrator          = "TVD-RK3"
run.do_reflux               = 1


# =====================================================================
# REFINEMENT CRITERIA: the gradient of the material indicator
# Phase = sum_p p alpha_p, which follows both interfaces, and of the
# pressure, which follows the shocks
# =====================================================================
run.refine.ref_vars        = Phase P
run.refine.Phase.max_level = 10
run.refine.Phase.grad      = 0.01 0.01 0.01 0.01 0.01 0.01 0.01
run.refine.P.max_level     = 10
run.refine.P.grad          = 0.5 0.5 0.5 0.5 0.5 0.5 0.5


# =====================================================================
# OUTPUT
# =====================================================================
amr.case_name        = ./plot/CylindricalRM-5Eq-N
amr.plot_int         = 10000000
amr.t_write_interval = 0.02                # A plotfile every 0.02 time units
run.output_vars      = a1 a2 a3 rho P Phase
amr.chk_file         = ./checkpoints/chk
amr.chk_int          = 20000
run.user_output_int  = 1                   # Interface radii and amplitudes every coarse step


# =====================================================================
# PHYSICS AND METHODS
# =====================================================================
Physics.source_term   = 1                  # Five-equation model with the K div(u) term
Physics.RiemannSolver = "HLLC"

FiniteVolume.Scheme = "MUSCL-MC"
FiniteVolume.THINC  = 1                    # THINC reconstruction of the interfaces
FiniteVolume.THINC.Beta            = 2.3   # Interface steepness
FiniteVolume.THINC.EPS             = 1.0e-4
FiniteVolume.THINC.UseNormal       = 1     # Multidimensional THINC along the interface normal
FiniteVolume.THINC.NormalThreshold = 0.4
FiniteVolume.THINC.Multi           = 1     # Multi-dimensional THINC face averages
FiniteVolume.THINC.FaceState       = 1     # Only the THINC side of a face is rebuilt; u and p keep the base scheme
FiniteVolume.THINC.PhaseDensity    = 1     # Phase densities of the cell (use together with FaceState = 1)

PhaseField.phase_field    = 0              # Phase-Field off (THINC keeps the interfaces sharp)
PhaseField.Eta_Multiplier = 0.5            # Initial interface width, eta = 0.5 finest cells


# =====================================================================
# MATERIALS AND PROBLEM
# =====================================================================
prob.EOS.EOS   = 0                         # Ideal gases
prob.EOS.gamma = 1.4  1.094  1.667         # Air, SF6, helium
prob.EOS.pinf  = 0.0  0.0    0.0

prob.rho     = 1.0  5.04  0.138            # Densities at the same pressure and temperature
prob.P0      = 1.0                         # Pressure ahead of the shock
prob.Mach    = 2.0                         # Shock Mach number in air
prob.Rs      = 0.92                        # Initial shock radius
prob.R_12    = 0.75                        # Mean radius of the air / SF6 interface
prob.R_23    = 0.5                         # Mean radius of the SF6 / helium interface
prob.a_12    = 0.03                        # Perturbation amplitude of the outer interface
prob.a_23    = 0.02                        # Perturbation amplitude of the inner interface
prob.mode_12 = 16                          # Mode number of the outer interface (even)
prob.mode_23 = 12                          # Mode number of the inner interface (even)
