# =====================================================================
# HEAT CONDUCTION ACROSS A STATIONARY CONTACT, N-PHASE SIX-EQUATION
# MODEL
# The same gas on both sides of x = 0.5 at the uniform pressure 1, with
# T = 1.01 on the left and 0.99 on the right. Phase 1 fills the left and
# phase 2 the right. Each phase conducts only through itself and this
# model has no heat exchange between the phases (pressure relaxation
# only), so no heat crosses from one phase to the other: each side keeps
# its temperature. With prob.layout = 1 (a variant) the two phases fill
# the box as a uniform mixture and each follows the erf profile of
# constant-pressure conduction with chi = kappa/(rho cp) = 0.0018. A
# strip of 256 x 8 cells, periodic in y, closed by slip walls (adiabatic)
# in x. This is the base test of the phase heat fluxes of DIFFUSION =
# true for the N-phase six-equation model (internal energy form, NPHASE =
# 2, set in the GNUmakefile). Nondimensional units.
# =====================================================================

# =====================================================================
# SIMULATION CONTROL
# =====================================================================
max_step  = 1000000         # Maximum number of time steps to advance
stop_time = 0.5


# =====================================================================
# DOMAIN GEOMETRY
# =====================================================================
geometry.prob_lo     = 0.0 0.0          # Lower bounds (x,y)
geometry.prob_hi     = 1.0 0.03125      # Upper bounds (x,y): a strip of square cells
geometry.is_periodic = 0   1            # Periodic in y


# =====================================================================
# BOUNDARY CONDITIONS
#   0 = Interior    | 1 = Inflow      | 2 = Outflow
#   3 = Symmetry    | 4 = SlipWall    | 5 = NoSlipWall
# =====================================================================
run.lo_bc = 4 0              # Slip (adiabatic) walls in x
run.hi_bc = 4 0


# =====================================================================
# VERBOSITY
# =====================================================================
amr.v       = 1
run.sum_var = 0


# =====================================================================
# GRID AND REFINEMENT
# =====================================================================
amr.n_cell      = 256 8      # Base grid resolution (coarsest level)
amr.max_level   = 0          # No refinement; the amr variant adds a level at the contact
amr.ref_ratio   = 2 2 2 2 2 2
amr.n_error_buf = 1

amr.blocking_factor_x = 8
amr.blocking_factor_y = 8
amr.max_grid_size     = 32
amr.regrid_int        = 2
amr.Interpolater      = "lincc_interp"


# =====================================================================
# TIME STEPPING
# =====================================================================
run.cfl                     = 0.4
run.vnn                     = 0.2          # Diffusive limit, dt = vnn dx^2 / (largest diffusivity)
run.do_subcycle             = 1
run.check_cfl               = 0
run.timestep_change_limiter = 0
run.TimeIntegrator          = "TVD-RK3"
run.do_reflux               = 1


# =====================================================================
# REFINEMENT CRITERIA (with amr.max_level > 0): the temperature jump
# =====================================================================
run.refine.ref_vars    = T
run.refine.T.max_level = 10
run.refine.T.grad      = 0.0005 0.0005 0.0005 0.0005


# =====================================================================
# OUTPUT
# =====================================================================
amr.case_name        = ./plot/HeatConduction-6Eq-N
amr.plot_int         = 1000000
amr.t_write_interval = 0.1                 # A plotfile every 0.1
run.output_vars      = a1 a2 a1rho1 a2rho2 a1rho1e1 a2rho2e2 rho_u rho_v rho_E rho u v P a1p1 a2p2 T
amr.chk_file         = ./checkpoints/chk
amr.chk_int          = 20000
run.user_output_int  = 1                   # Volumes, energy and temperature errors every coarse step


# =====================================================================
# PHYSICS AND METHODS
# =====================================================================
Physics.pressure_relaxation = 1
Physics.RiemannSolver       = "HLLC"

FiniteVolume.Scheme = "MUSCL-MC"
FiniteVolume.THINC  = 0

PhaseField.phase_field    = 0
PhaseField.Eta_Multiplier = 1.0            # Width of the initial profile of alpha, in cells


# =====================================================================
# PROBLEM
# =====================================================================
prob.layout  = 0                           # 0: each phase fills one side, 1: uniform mixture
prob.P0      = 1.0
prob.T_L     = 1.01
prob.T_R     = 0.99
prob.x0      = 0.5
prob.alpha_1 = 0.5                         # With prob.layout = 1
prob.eps     = 1.0e-6                      # Trace of the other phase with prob.layout = 0


# =====================================================================
# MATERIALS
# The same ideal gas in both phases, R = (gamma - 1) cv = 1, so rho = P/T
# =====================================================================
prob.EOS.EOS   = 1                         # Stiffened gas with pinf = 0
prob.EOS.gamma = 1.4 1.4
prob.EOS.pinf  = 0.0 0.0
prob.EOS.cv    = 2.5 2.5

prob.EOS.mu    = 0.001 0.001
prob.EOS.muB   = 0.0 0.0
prob.EOS.kappa = 0.0063 0.0063             # chi = kappa/(rho cp) = 0.0018
