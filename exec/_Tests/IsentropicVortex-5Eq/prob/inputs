# =====================================================================
# ISENTROPIC VORTEX
# The isentropic vortex of Shu (1998) is carried by the uniform flow
# (1,1) across the periodic box [-5,5]^2 for one period. The case tests
# the high-order WENO5 scheme with quadrature (FiniteVolume.Quad = 1) on
# a smooth solution, and is the convergence case of
# scripts/convergence.py: with CONVERGENCE defined in prob/ProblemICBC.H,
# COMPAS writes the error norms against the exact solution at the end of
# the run. Single fluid, nondimensional units.
#
# Run the convergence study from this directory with
#   python3 ../../../scripts/convergence.py --run --res 24 36 48 72 96
# and plot it with
#   python3 ../../../scripts/convergence.py --vars a1rho1 rho_E rho_u --plot
# =====================================================================

# =====================================================================
# SIMULATION CONTROL
# =====================================================================
max_step  = 10000000        # Maximum number of time steps to advance
stop_time = 10.0            # One period of the periodic box


# =====================================================================
# DOMAIN GEOMETRY
# =====================================================================
geometry.prob_lo     = -5.0 -5.0 -5.0   # Lower bounds (x,y,z)
geometry.prob_hi     =  5.0  5.0  5.0   # Upper bounds (x,y,z)
geometry.is_periodic =  1    1    1


# =====================================================================
# BOUNDARY CONDITIONS
#   0 = Interior    | 1 = Inflow      | 2 = Outflow
#   3 = Symmetry    | 4 = SlipWall    | 5 = NoSlipWall
# =====================================================================
run.lo_bc = 0 0 0            # Periodic in every direction
run.hi_bc = 0 0 0


# =====================================================================
# VERBOSITY
# =====================================================================
amr.v       = 1
run.sum_var = 0              # Sum a1rho1 every step to check conservation


# =====================================================================
# GRID
# A single 32 x 32 level (the error norms are computed on level 0 only);
# scripts/convergence.py overrides amr.n_cell
# =====================================================================
amr.n_cell      = 32 32 8    # Base grid resolution
amr.max_level   = 0          # No refinement
amr.n_error_buf = 1

amr.blocking_factor_x = 2    # Small, so that every resolution of the convergence study is allowed
amr.blocking_factor_y = 2
amr.blocking_factor_z = 2
amr.max_grid_size     = 8
amr.regrid_int        = 1
amr.Interpolater      = "quartic_interp"   # High-order coarse-fine interpolation, if refinement is turned on


# =====================================================================
# TIME STEPPING
# =====================================================================
run.cfl                     = 0.4
run.do_subcycle             = 1
run.check_cfl               = 0
run.timestep_change_limiter = 0
run.TimeIntegrator          = "TVD-RK3"
run.do_reflux               = 1


# =====================================================================
# REFINEMENT CRITERIA (used only if amr.max_level > 0): the gradient of
# the density
# =====================================================================
run.refine.ref_vars      = rho
run.refine.rho.max_level = 10
run.refine.rho.grad      = 0.01 0.01 0.01 0.01 0.01 0.01 0.01


# =====================================================================
# OUTPUT
# =====================================================================
amr.case_name        = ./plot/IsentropicVortex-WENO5-Quad
amr.plot_int         = 1000000
amr.t_write_interval = 1.0                 # A plotfile every time unit
run.output_vars      = a1rho1 rho u v P a1
amr.chk_file         = ./checkpoints/chk
amr.chk_int          = 20000


# =====================================================================
# PHYSICS AND METHODS
# =====================================================================
Physics.source_term   = 0                  # No K div(u) term (single fluid)
Physics.RiemannSolver = "HLLC"

FiniteVolume.Scheme = "WENO5"
FiniteVolume.Quad   = 1                    # High-order WENO5 with quadrature over the cell faces (2D five-equation model only)

FiniteVolume.THINC  = 0                    # No interfaces
FiniteVolume.THINC.Beta            = 2.3
FiniteVolume.THINC.EPS             = 1.0e-4
FiniteVolume.THINC.UseNormal       = 1
FiniteVolume.THINC.NormalThreshold = 0.4

PhaseField.phase_field    = 0              # No interfaces
PhaseField.Mechanism      = "CAC-Adv"
PhaseField.ID_ExplicitRC  = 0
PhaseField.cfl            = 0.3
PhaseField.Eta_Multiplier = 0.5


# =====================================================================
# MATERIALS (ideal gas). Only material 1 is present.
# =====================================================================
prob.EOS.EOS     = 0
prob.EOS.gamma_1 = 1.4
prob.EOS.gamma_2 = 1.4
prob.EOS.pinf_1  = 0.0
prob.EOS.pinf_2  = 0.0
