# =====================================================================
# SHOCK-VORTEX INTERACTION
# A composite vortex of Mach number 0.9 is carried by the Mach 1.5 flow
# through a stationary normal shock at x = 0.5, in the channel
# [0,2] x [0,1], as in Rault, Chiavassa and Donat (J. Sci. Comput. 19,
# 2003). The case tests the high-order WENO5 scheme with quadrature
# (FiniteVolume.Quad = 1) with AMR, on a problem with both a shock and a
# smooth vortex. Single fluid, nondimensional units.
# =====================================================================

# =====================================================================
# SIMULATION CONTROL
# =====================================================================
max_step  = 100000          # Maximum number of time steps to advance
stop_time = 0.7


# =====================================================================
# DOMAIN GEOMETRY
# =====================================================================
geometry.prob_lo     = 0.0  0.0  0.0    # Lower bounds (x,y,z)
geometry.prob_hi     = 2.0  1.0  1.0    # Upper bounds (x,y,z)
geometry.is_periodic = 0    0    0


# =====================================================================
# BOUNDARY CONDITIONS
#   0 = Interior    | 1 = Inflow      | 2 = Outflow
#   3 = Symmetry    | 4 = SlipWall    | 5 = NoSlipWall
# =====================================================================
run.lo_bc = 2 4 4            # Zero-gradient at the supersonic inlet and the outlet,
run.hi_bc = 2 4 4            # slip walls at y = 0 and y = 1


# =====================================================================
# VERBOSITY
# =====================================================================
amr.v       = 1
run.sum_var = 0              # Sum a1rho1 every step (NaN check)


# =====================================================================
# GRID AND REFINEMENT
# 128 x 64 base grid and two levels, 512 x 256 at the finest level
# =====================================================================
amr.n_cell      = 128 64 8   # Base grid resolution (coarsest level)
amr.max_level   = 2          # Number of refinement levels above the base grid
amr.ref_ratio   = 2 2 2 2 2 2
amr.n_error_buf = 1          # Buffer around tagged cells for refinement

amr.blocking_factor_x = 8
amr.blocking_factor_y = 8
amr.blocking_factor_z = 8
amr.max_grid_size     = 8
amr.regrid_int        = 1
amr.Interpolater      = "lincc_interp"


# =====================================================================
# TIME STEPPING
# =====================================================================
run.cfl                     = 0.4
run.do_subcycle             = 1
run.check_cfl               = 0
run.timestep_change_limiter = 0
run.TimeIntegrator          = "TVD-RK3"
run.do_reflux               = 1


# =====================================================================
# REFINEMENT CRITERIA: the gradient of the density, which follows the
# shock and the vortex
# =====================================================================
run.refine.ref_vars      = rho
run.refine.rho.max_level = 10
run.refine.rho.grad      = 0.01 0.01 0.01 0.01 0.01 0.01 0.01


# =====================================================================
# OUTPUT
# =====================================================================
amr.case_name        = ./plot/ShockVortex-WENO5-Quad
amr.plot_int         = 1000000
amr.t_write_interval = 0.1                 # A plotfile every 0.1 time units
run.output_vars      = a1rho1 rho u v P a1
amr.chk_file         = ./checkpoints/chk
amr.chk_int          = 20000
run.user_output_int  = 1                   # Position and pressure of the vortex core every coarse step


# =====================================================================
# PHYSICS AND METHODS
# =====================================================================
Physics.source_term   = 0                  # No K div(u) term (single fluid)
Physics.RiemannSolver = "HLLC"

FiniteVolume.Scheme = "WENO5"
FiniteVolume.Quad   = 1                    # High-order WENO5 with quadrature over the cell faces (2D five-equation model only)

FiniteVolume.THINC  = 0                    # No interfaces
FiniteVolume.THINC.Beta            = 2.3
FiniteVolume.THINC.EPS             = 1.0e-4
FiniteVolume.THINC.UseNormal       = 1
FiniteVolume.THINC.NormalThreshold = 0.4

PhaseField.phase_field    = 0              # No interfaces
PhaseField.Mechanism      = "CAC-Adv"
PhaseField.ID_ExplicitRC  = 0
PhaseField.cfl            = 0.3
PhaseField.Eta_Multiplier = 0.5


# =====================================================================
# MATERIALS (ideal gas). Only material 2 is present.
# =====================================================================
prob.EOS.EOS     = 0
prob.EOS.gamma_1 = 1.4
prob.EOS.gamma_2 = 1.4
prob.EOS.pinf_1  = 0.0
prob.EOS.pinf_2  = 0.0
