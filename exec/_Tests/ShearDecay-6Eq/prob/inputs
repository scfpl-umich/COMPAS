# =====================================================================
# DECAY OF A SHEAR WAVE, TWO-PHASE SIX-EQUATION MODEL WITH VISCOSITY
# A shear wave u = U sin(2 pi y), v = 0, in a uniform mixture of two
# gases with different viscosities, alpha_1 = 0.4, in a periodic box.
# The amplitude decays as exp(-nu k^2 t) with k = 2 pi and the mixture
# kinematic viscosity nu = (alpha_1 mu_1 + alpha_2 mu_2)/rho = 0.00325,
# and the dissipated kinetic energy goes into the phase internal energies
# in the ratio alpha_1 mu_1 : alpha_2 mu_2 (without relaxation). This is
# the base test of DIFFUSION = true for the two-phase six-equation model;
# variants.txt reruns it with the relaxations, without AMR and with
# WENO5. Nondimensional units.
# =====================================================================

# =====================================================================
# SIMULATION CONTROL
# =====================================================================
max_step  = 1000000         # Maximum number of time steps to advance
stop_time = 2.0


# =====================================================================
# DOMAIN GEOMETRY
# =====================================================================
geometry.prob_lo     = 0.0 0.0          # Lower bounds (x,y)
geometry.prob_hi     = 1.0 1.0          # Upper bounds (x,y)
geometry.is_periodic = 1   1            # Periodic in x and y


# =====================================================================
# BOUNDARY CONDITIONS
#   0 = Interior    | 1 = Inflow      | 2 = Outflow
#   3 = Symmetry    | 4 = SlipWall    | 5 = NoSlipWall
# =====================================================================
run.lo_bc = 0 0
run.hi_bc = 0 0


# =====================================================================
# VERBOSITY
# =====================================================================
amr.v       = 1
run.sum_var = 0


# =====================================================================
# GRID AND REFINEMENT
# 64 x 64 base grid and one level where the shear is largest, so that
# the viscous fluxes cross coarse-fine boundaries and are refluxed
# =====================================================================
amr.n_cell      = 64 64      # Base grid resolution (coarsest level)
amr.max_level   = 1          # Number of refinement levels above the base grid
amr.ref_ratio   = 2 2 2 2 2 2
amr.n_error_buf = 1          # Buffer around tagged cells for refinement

amr.blocking_factor_x = 8
amr.blocking_factor_y = 8
amr.max_grid_size     = 16
amr.regrid_int        = 2
amr.Interpolater      = "lincc_interp"


# =====================================================================
# TIME STEPPING
# =====================================================================
run.cfl                     = 0.4
run.vnn                     = 0.2          # Diffusive limit, dt = vnn dx^2 / (largest diffusivity)
run.do_subcycle             = 1
run.check_cfl               = 0
run.timestep_change_limiter = 0
run.TimeIntegrator          = "TVD-RK3"
run.do_reflux               = 1


# =====================================================================
# REFINEMENT CRITERIA: the jump in u between neighboring cells, which
# tags the bands around y = 0 and y = 0.5 where |du/dy| is largest
# =====================================================================
run.refine.ref_vars    = u
run.refine.u.max_level = 10
run.refine.u.grad      = 0.0007 0.0007 0.0007 0.0007


# =====================================================================
# OUTPUT
# =====================================================================
amr.case_name        = ./plot/ShearDecay-6Eq
amr.plot_int         = 1000000
amr.t_write_interval = 0.5                 # A plotfile every 0.5
run.output_vars      = a1rho1 a2rho2 rho_u rho_v a1rho1E1 a2rho2E2 a1 rho u v P a1P1 a2P2
amr.chk_file         = ./checkpoints/chk
amr.chk_int          = 20000
run.user_output_int  = 1                   # Integrals and amplitude every coarse step


# =====================================================================
# PHYSICS AND METHODS
# No relaxation in the base run, so that each phase keeps the energy it
# dissipates; the variants switch the relaxations on.
# =====================================================================
Physics.pressure_relaxation             = 0
Physics.pressure_temperature_relaxation = 0
Physics.RiemannSolver                   = "HLLC"

FiniteVolume.Scheme = "MUSCL-MC"
FiniteVolume.THINC  = 0

PhaseField.phase_field    = 0
PhaseField.Eta_Multiplier = 0.5


# =====================================================================
# PROBLEM
# =====================================================================
prob.U       = 0.01                        # Amplitude of the wave (Mach number about 0.01)
prob.mode    = 1                           # One wavelength across the box
prob.axis    = 1                           # The wave varies along y (2: along z, in 3D)
prob.P0      = 1.0
prob.alpha_1 = 0.4
prob.rho_1   = 1.0
prob.rho_2   = 2.0


# =====================================================================
# MATERIALS
# Two ideal gases with different viscosities and conductivities
# =====================================================================
prob.EOS.EOS     = 1                       # Stiffened gas with pinf = 0
prob.EOS.gamma_1 = 1.4
prob.EOS.gamma_2 = 1.6
prob.EOS.pinf_1  = 0.0
prob.EOS.pinf_2  = 0.0
prob.EOS.cv_1    = 1.0
prob.EOS.cv_2    = 1.5

prob.EOS.mu_1    = 0.01                    # Shear viscosities
prob.EOS.mu_2    = 0.002
prob.EOS.muB_1   = 0.0                     # Bulk viscosities
prob.EOS.muB_2   = 0.0
prob.EOS.kappa_1 = 0.001                   # Thermal conductivities
prob.EOS.kappa_2 = 0.002
