# =====================================================================
# SHOCK-AIR BUBBLE INTERACTION IN WATER
# A Mach 1.2 shock in water (material 1, stiffened gas) hits a cylindrical
# air bubble (material 2, ideal gas) of diameter 1. Only the upper half is
# simulated, with symmetry on the axis. Exercises the six-equation model
# with instantaneous pressure relaxation, THINC reconstruction of the
# interface and AMR. Densities are scaled by prob.rho0, pressures by
# prob.P0, velocities by u0 = sqrt(P0/rho0), and lengths by the bubble
# diameter D.
# =====================================================================

# =====================================================================
# SIMULATION CONTROL
# =====================================================================
max_step  = 100000          # Maximum number of time steps to advance
stop_time = 0.02            # Maximum time, in units of D/u0


# =====================================================================
# DOMAIN GEOMETRY
# The bubble is centered at the origin, on the lower boundary
# =====================================================================
geometry.prob_lo     = -1.25  0.0 -1.0  # Lower bounds (x,y,z)
geometry.prob_hi     =  2.75  2.0  1.0  # Upper bounds (x,y,z)
geometry.is_periodic =  0     0    0


# =====================================================================
# BOUNDARY CONDITIONS
#   0 = Interior    | 1 = Inflow      | 2 = Outflow
#   3 = Symmetry    | 4 = SlipWall    | 5 = NoSlipWall
# =====================================================================
run.lo_bc = 2 3 4            # Outflow in x, symmetry on the axis y = 0
run.hi_bc = 2 2 4            # Outflow in x and at the top


# =====================================================================
# VERBOSITY
# =====================================================================
amr.v       = 1
run.sum_var = 4              # Index of the conservative variable to sum (a1rho1E1 in 2D)


# =====================================================================
# GRID AND REFINEMENT
# 256 x 128 square cells on the base grid and one level of refinement
# =====================================================================
amr.n_cell      = 256 128 8  # Base grid resolution (coarsest level)
amr.max_level   = 1          # Number of refinement levels above the base grid
amr.ref_ratio   = 2 2 2 2 2 2
amr.n_error_buf = 1          # Buffer around tagged cells for refinement

amr.blocking_factor_x = 16
amr.blocking_factor_y = 16
amr.blocking_factor_z = 16
amr.max_grid_size     = 16
amr.regrid_int        = 1
amr.Interpolater      = "lincc_interp"


# =====================================================================
# TIME STEPPING
# =====================================================================
run.cfl                     = 0.4
run.do_subcycle             = 1
run.check_cfl               = 0
run.timestep_change_limiter = 0
run.TimeIntegrator          = "TVD-RK3"
run.do_reflux               = 1


# =====================================================================
# REFINEMENT CRITERIA: the gradient of alpha_1 (per cell), which follows
# the interface, and the gradient of the scaled pressure, which follows
# the shocks
# =====================================================================
run.refine.ref_vars     = a1 P

run.refine.a1.max_level = 10
run.refine.a1.grad      = 0.01 0.01 0.01 0.01 0.01 0.01 0.01 0.01 0.01 0.01

run.refine.P.max_level  = 10
run.refine.P.grad       = 100.0 100.0 100.0 100.0 100.0 100.0 100.0 100.0


# =====================================================================
# OUTPUT
# =====================================================================
amr.case_name        = ./plot/ShockBubble-WaterAir-6Eq
amr.plot_int         = 1000000
amr.t_write_interval = 0.0001              # A plotfile every 1e-4 time units
run.output_vars      = a1rho1 rho u v P a1P1 a2P2 a1rho1E1 a2rho2E2 a1
amr.chk_file         = ./checkpoints/chk
amr.chk_int          = 20000
run.user_output_int  = 1                   # Bubble volume, centroid, velocity and axial interfaces every coarse step


# =====================================================================
# PHYSICS AND METHODS
# =====================================================================
Physics.pressure_relaxation = 1            # Instantaneous pressure relaxation
Physics.RiemannSolver       = "HLLC"

FiniteVolume.Scheme = "MUSCL"
FiniteVolume.THINC  = 1                    # THINC reconstruction of the interface
FiniteVolume.THINC.Beta      = 2.3
FiniteVolume.THINC.EPS       = 1.0e-4
FiniteVolume.THINC.UseNormal = 1

PhaseField.phase_field    = 0              # 1 for Phase-Field regularization of the interface
PhaseField.cfl            = 0.3            # This and the next two apply when phase_field = 1
PhaseField.Mechanism      = "ACDI"
PhaseField.ID_ExplicitRC  = 1
PhaseField.Eta_Multiplier = 0.5            # Initial interface width, eta = 0.5 finest cells


# =====================================================================
# MATERIALS AND PROBLEM (SI units, scaled in Parm.H)
# =====================================================================
prob.EOS.EOS     = 1
prob.EOS.gamma_1 = 4.4                     # water
prob.EOS.gamma_2 = 1.4                     # air
prob.EOS.pinf_1  = 6e8                     # Pa
prob.EOS.pinf_2  = 0.0

prob.rho0 = 1000                           # water density ahead of the shock, kg/m^3
prob.P0   = 101325                         # pressure ahead of the shock, Pa
prob.Mach = 1.2                            # shock Mach number in water
