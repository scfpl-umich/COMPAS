# =====================================================================
# SHOCK-AIR BUBBLE INTERACTION IN WATER, N-PHASE MODEL
# A Mach 1.1 shock in water (material 1, stiffened gas) hits a cylindrical
# air bubble (material 2, ideal gas) of diameter 1. Only the upper half is
# simulated, with symmetry on the axis. The setup of
# ShockBubble-WaterAir-6Eq at a lower Mach number, run with the N-phase
# six-equation model (internal-energy form, NPHASE = 2) and instantaneous
# pressure relaxation.
# Densities are scaled by prob.rho0, pressures by prob.P0, velocities by
# u0 = sqrt(P0/rho0), and lengths by the bubble diameter D.
# =====================================================================

# =====================================================================
# SIMULATION CONTROL
# =====================================================================
max_step  = 100000          # Maximum number of time steps to advance
stop_time = 0.03            # Maximum time, in units of D/u0


# =====================================================================
# DOMAIN GEOMETRY
# The bubble is centered at the origin, on the lower boundary
# =====================================================================
geometry.prob_lo     = -1.25  0.0 -1.0  # Lower bounds (x,y,z)
geometry.prob_hi     =  2.75  2.0  1.0  # Upper bounds (x,y,z)
geometry.is_periodic =  0     0    0


# =====================================================================
# BOUNDARY CONDITIONS
#   0 = Interior    | 1 = Inflow      | 2 = Outflow
#   3 = Symmetry    | 4 = SlipWall    | 5 = NoSlipWall
# =====================================================================
run.lo_bc = 2 3 4            # Outflow in x, symmetry on the axis y = 0
run.hi_bc = 2 2 4            # Outflow in x and at the top


# =====================================================================
# VERBOSITY
# =====================================================================
amr.v       = 1
run.sum_var = 2              # Index of the conservative variable to sum (a1rho1)


# =====================================================================
# GRID AND REFINEMENT
# 128 x 64 square cells on the base grid and three levels of refinement.
# Everything within a distance 2 of the bubble center is also refined to
# the finest level (spatio_temporal_tag in ProblemICBC.H)
# =====================================================================
amr.n_cell      = 128 64 8   # Base grid resolution (coarsest level)
amr.max_level   = 3          # Number of refinement levels above the base grid
amr.ref_ratio   = 2 2 2 2 2 2
amr.n_error_buf = 1          # Buffer around tagged cells for refinement

amr.blocking_factor_x = 16
amr.blocking_factor_y = 16
amr.blocking_factor_z = 16
amr.max_grid_size     = 16
amr.regrid_int        = 1
amr.Interpolater      = "pc_interp"        # Piecewise-constant coarse-to-fine interpolation


# =====================================================================
# TIME STEPPING
# =====================================================================
run.cfl                     = 0.3
run.do_subcycle             = 1
run.check_cfl               = 0
run.timestep_change_limiter = 0
run.TimeIntegrator          = "TVD-RK3"
run.do_reflux               = 1


# =====================================================================
# REFINEMENT CRITERIA: the gradient of the scaled mixture density, which
# follows the interface, and of the scaled pressure, which follows the
# shocks
# =====================================================================
run.refine.ref_vars      = rho P

run.refine.rho.max_level = 10
run.refine.rho.grad      = 0.01 0.01 0.01 0.01 0.01 0.01 0.01 0.01 0.01 0.01

run.refine.P.max_level   = 10
run.refine.P.grad        = 100.0 100.0 100.0 100.0 100.0 100.0 100.0 100.0


# =====================================================================
# OUTPUT
# =====================================================================
amr.case_name        = ./plot/ShockBubble-WaterAir-6Eq-Nphase
amr.plot_int         = 1000000
amr.t_write_interval = 0.001               # A plotfile every 1e-3 time units
run.output_vars      = a1 a2 a1rho1 a2rho2 a1rho1e1 a2rho2e2 rho u v P a1p1 a2p2
amr.chk_file         = ./checkpoints/chk
amr.chk_int          = 20000
run.user_output_int  = 1                   # Bubble volume, centroid, velocity and axial interfaces every coarse step


# =====================================================================
# PHYSICS AND METHODS
# =====================================================================
Physics.pressure_relaxation = 1            # Instantaneous pressure relaxation
Physics.RiemannSolver       = "HLLC"

FiniteVolume.Scheme = "MUSCL"
FiniteVolume.THINC  = 0                    # 1 for THINC reconstruction of the interface
FiniteVolume.THINC.Beta      = 2.3
FiniteVolume.THINC.EPS       = 1.0e-5
FiniteVolume.THINC.UseNormal = 1

PhaseField.phase_field    = 0              # 1 for Phase-Field regularization of the interface
PhaseField.cfl            = 0.2            # This and the next two apply when phase_field = 1
PhaseField.Mechanism      = "CDI"
PhaseField.ID_ExplicitRC  = 1
PhaseField.Eta_Multiplier = 0.5            # Initial interface width, eta = 0.5 finest cells


# =====================================================================
# MATERIALS AND PROBLEM (SI units, scaled in Parm.H)
# =====================================================================
prob.EOS.EOS   = 1
prob.EOS.gamma = 4.4    1.4                # water, air
prob.EOS.pinf  = 6.0e8  0.0                # Pa

prob.rho0 = 1000                           # water density ahead of the shock, kg/m^3
prob.P0   = 101325                         # pressure ahead of the shock, Pa
prob.Mach = 1.1                            # shock Mach number in water
