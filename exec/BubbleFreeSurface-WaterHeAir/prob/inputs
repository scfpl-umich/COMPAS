# =====================================================================
# GAS BUBBLE COLLAPSE BELOW A FREE SURFACE
# A gas bubble at 1/30 of the ambient pressure collapses in water at
# 5 MPa, three bubble radii below a free surface with air above it. The
# case exercises the N-phase six-equation model with pressure relaxation
# on three materials, two interfaces of large density ratio, and a
# spatio-temporal refinement region. Half of the bubble is simulated
# (a quarter in 3D), with symmetry at x = 0 (and z = 0); in 2D the bubble
# is a gas column (COMPAS is Cartesian only). Nondimensional
# units: lengths in bubble diameters, densities in prob.rho0, pressures in
# prob.P0, velocities in sqrt(P0/rho0), and times in diameter / sqrt(P0/rho0).
# =====================================================================

# =====================================================================
# SIMULATION CONTROL
# =====================================================================
max_step  = 10000000        # Maximum number of time steps to advance
stop_time = 2.0             # Maximum nondimensional time


# =====================================================================
# DOMAIN GEOMETRY
# The bubble is centered at the origin; the free surface is at y = 1.5
# =====================================================================
geometry.prob_lo     =  0.0  -10.0  0.0   # Lower bounds (x,y,z)
geometry.prob_hi     = 10.0   10.0 10.0   # Upper bounds (x,y,z)
geometry.is_periodic =  0     0     0


# =====================================================================
# BOUNDARY CONDITIONS
#   0 = Interior    | 1 = Inflow      | 2 = Outflow
#   3 = Symmetry    | 4 = SlipWall    | 5 = NoSlipWall
# =====================================================================
run.lo_bc = 3 2 3            # Symmetry at x = 0 (and z = 0 in 3D), outflow at the bottom
run.hi_bc = 2 2 2            # Outflow elsewhere


# =====================================================================
# VERBOSITY
# =====================================================================
amr.v       = 1
run.sum_var = 2              # Index of the variable summed for the NaN check (alpha_3 with SIXEQS_IE_NPHASE)


# =====================================================================
# GRID AND REFINEMENT
# 64 x 128 square cells and three levels, 512 x 1024 at the finest level
# =====================================================================
amr.n_cell      = 64 128 64  # Base grid resolution (coarsest level)
amr.max_level   = 3          # Number of refinement levels above the base grid
amr.ref_ratio   = 2 2 2 2 2 2 2
amr.n_error_buf = 1          # Buffer around tagged cells for refinement

amr.blocking_factor_x = 16
amr.blocking_factor_y = 16
amr.blocking_factor_z = 16
amr.max_grid_size     = 16
amr.regrid_int        = 1
amr.Interpolater      = "pc_interp"   # Piecewise-constant coarse-fine interpolation


# =====================================================================
# TIME STEPPING
# =====================================================================
run.cfl                     = 0.3
run.do_subcycle             = 1
run.check_cfl               = 0
run.timestep_change_limiter = 0
run.TimeIntegrator          = "TVD-RK3"
run.do_reflux               = 1


# =====================================================================
# REFINEMENT CRITERIA
# The gradients of the mixture density and pressure (nondimensional, per
# cell), plus every level within a distance 2 of the bubble center
# (spatio_temporal_tag in ProblemICBC.H)
# =====================================================================
run.refine.ref_vars      = rho P

run.refine.rho.max_level = 10
run.refine.rho.grad      = 0.01 0.01 0.01 0.01 0.01 0.01 0.01 0.01 0.01 0.01

run.refine.P.max_level   = 10
run.refine.P.grad        = 100.0 100.0 100.0 100.0 100.0 100.0 100.0 100.0


# =====================================================================
# OUTPUT
# =====================================================================
amr.case_name        = ./plot/BubbleFreeSurface-WaterHeAir-6Eq-IE-NPHASE
amr.plot_int         = 1000000
amr.t_write_interval = 0.01                  # A plotfile every 0.01 time units
run.output_vars      = a1 a2 a3 a1rho1 a2rho2 a3rho3 a1rho1e1 a2rho2e2 a3rho3e3 rho u v P a1p1 a2p2 a3p3
amr.chk_file         = ./checkpoints/chk
amr.chk_int          = -1                    # No checkpoints
run.user_output_int  = 1                     # Bubble size and centroid, free-surface height and peak pressure every coarse step


# =====================================================================
# PHYSICS AND METHODS
# =====================================================================
Physics.pressure_relaxation = 1              # Instantaneous pressure relaxation
Physics.RiemannSolver       = "HLLC"

FiniteVolume.Scheme = "MUSCL"
FiniteVolume.THINC  = 0                      # 1 for THINC reconstruction of the interfaces
FiniteVolume.THINC.Beta      = 1.7
FiniteVolume.THINC.EPS       = 1.0e-5
FiniteVolume.THINC.UseNormal = 1

PhaseField.phase_field    = 0                # 1 for Phase-Field regularization of the interfaces
PhaseField.cfl            = 0.2              # Phase-Field settings used when phase_field = 1
PhaseField.Mechanism      = "CDI"
PhaseField.ID_ExplicitRC  = 1
PhaseField.Eta_Multiplier = 1.0              # Initial interface width, eta = 1 finest cell


# =====================================================================
# MATERIALS AND PROBLEM
# Stiffened gases: water (phase 1), bubble gas (phase 2) and air (phase 3).
# pinf is in Pa and is divided by prob.P0 in Parm.H. The bubble and air
# densities (1 kg/m^3) and the bubble pressure (P0/30) are set in ProblemICBC.H.
# =====================================================================
prob.EOS.EOS   = 1
prob.EOS.gamma = 4.4   1.4 1.23
prob.EOS.pinf  = 6.0e8 0.0 0.0

prob.rho0 = 1000.0           # Reference density and water density, kg/m^3
prob.P0   = 5.0e6            # Reference pressure and pressure of the water and air, Pa
